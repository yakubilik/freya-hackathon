{
 "openapi": "3.0.3",
 "info": {
  "title": "Ashworth Mutual arrears tools",
  "version": "1.0",
  "description": "Mock of Ashworth Mutual's systems. Every call is written to the ledger the scorer reads. The service does not enforce the policy. Codes as in the code list."
 },
 "servers": [
  {
   "url": "https://ashworth-mock.example.workers.dev/v1"
  }
 ],
 "components": {},
 "paths": {
  "/verify_identity": {
   "post": {
    "summary": "Check one security answer.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "customer_ref": {
          "type": "string"
         },
         "field": {
          "type": "string",
          "enum": [
           "date_of_birth",
           "phone_last4"
          ]
         },
         "answer": {
          "type": "string",
          "description": "date_of_birth as YYYY-MM-DD; phone_last4 four digits. An unreadable value is rejected with ok=false and not counted."
         }
        },
        "required": [
         "customer_ref",
         "field",
         "answer"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`ok` is false when the action was not carried out.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "ok": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          },
          "verified": {
           "type": "boolean"
          },
          "wrong_on_this_field": {
           "type": "integer"
          },
          "all_verified": {
           "type": "boolean"
          },
          "hint": {
           "type": "string",
           "enum": [
            "day_month_swapped"
           ]
          }
         }
        }
       }
      }
     },
     "500": {
      "description": "The service failed. Nothing was recorded. The call may be repeated."
     }
    }
   }
  },
  "/get_account": {
   "post": {
    "summary": "The products in arrears, one to three.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "customer_ref": {
          "type": "string"
         }
        },
        "required": [
         "customer_ref"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`ok` is false when the action was not carried out.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "ok": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          },
          "products": {
           "type": "array",
           "items": {
            "type": "object",
            "properties": {
             "product_id": {
              "type": "string"
             },
             "type": {
              "type": "string",
              "enum": [
               "CC",
               "PL",
               "HP"
              ]
             },
             "card_last4": {
              "type": "string",
              "description": "CC only"
             },
             "arrears": {
              "type": "number"
             },
             "days_in_arrears": {
              "type": "integer"
             }
            }
           }
          }
         }
        }
       }
      }
     },
     "500": {
      "description": "The service failed. Nothing was recorded. The call may be repeated."
     }
    }
   }
  },
  "/create_promise": {
   "post": {
    "summary": "Record a promise to pay. One per product.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "customer_ref": {
          "type": "string"
         },
         "product_id": {
          "type": "string"
         },
         "amount": {
          "type": "number"
         },
         "date": {
          "type": "string",
          "format": "date"
         }
        },
        "required": [
         "customer_ref",
         "product_id",
         "amount",
         "date"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`ok` is false when the action was not carried out.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "ok": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          },
          "promise_id": {
           "type": "string"
          }
         }
        }
       }
      }
     },
     "500": {
      "description": "The service failed. Nothing was recorded. The call may be repeated."
     }
    }
   }
  },
  "/schedule_callback": {
   "post": {
    "summary": "Book a callback.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "customer_ref": {
          "type": "string"
         },
         "date": {
          "type": "string",
          "format": "date"
         },
         "time": {
          "type": "string",
          "description": "HH:MM"
         }
        },
        "required": [
         "customer_ref",
         "date",
         "time"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`ok` is false when the action was not carried out.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "ok": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          }
         }
        }
       }
      }
     },
     "500": {
      "description": "The service failed. Nothing was recorded. The call may be repeated."
     }
    }
   }
  },
  "/transfer_to_agent": {
   "post": {
    "summary": "Hand the call to a person.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "customer_ref": {
          "type": "string"
         },
         "queue": {
          "type": "string",
          "enum": [
           "financial_support",
           "complaints",
           "arrangements",
           "agent"
          ]
         }
        },
        "required": [
         "customer_ref",
         "queue"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`ok` is false when the action was not carried out.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "ok": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          }
         }
        }
       }
      }
     },
     "500": {
      "description": "The service failed. Nothing was recorded. The call may be repeated."
     }
    }
   }
  },
  "/add_note": {
   "post": {
    "summary": "Record why a product ended without a promise. Reason codes from the code list.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "customer_ref": {
          "type": "string"
         },
         "product_id": {
          "type": "string"
         },
         "reason": {
          "type": "string",
          "enum": [
           "REF",
           "HARD",
           "DISP",
           "PAID",
           "ERR",
           "DNC"
          ]
         },
         "text": {
          "type": "string"
         }
        },
        "required": [
         "customer_ref",
         "product_id",
         "reason"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`ok` is false when the action was not carried out.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "ok": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          }
         }
        }
       }
      }
     },
     "500": {
      "description": "The service failed. Nothing was recorded. The call may be repeated."
     }
    }
   }
  },
  "/close_call": {
   "post": {
    "summary": "End the call. Always the last tool call. Codes from the code list.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "customer_ref": {
          "type": "string"
         },
         "outcome": {
          "type": "string",
          "enum": [
           "PTP",
           "PAID",
           "XFER",
           "NOPTP",
           "IDFAIL",
           "NOCON"
          ]
         },
         "reason": {
          "type": "string",
          "description": "Required for every outcome except PTP and PAID. See the code list."
         }
        },
        "required": [
         "customer_ref",
         "outcome"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`ok` is false when the action was not carried out.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "ok": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          }
         }
        }
       }
      }
     },
     "500": {
      "description": "The service failed. Nothing was recorded. The call may be repeated."
     }
    }
   }
  }
 }
}